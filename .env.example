# Токен бота от @BotFather
BOT_TOKEN=123456:replace-me
# Telegram ID администраторов через запятую
ADMIN_IDS=123456789

# PostgreSQL (те же значения использует контейнер postgres)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=octo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=octo

# Redis
REDIS_URL=redis://redis:6379/0

# Панель Remnawave: адрес и API-токен (в панели: Settings → API Tokens).
# Если бот на одном сервере с панелью (deploy/README.md): http://remnawave:3000
REMNAWAVE_URL=https://panel.example.com
REMNAWAVE_TOKEN=replace-me
# Ключ X-Api-Key, только если панель закрыта Caddy с авторизацией по ключу
REMNAWAVE_CADDY_TOKEN=
# UUID внутренних сквадов через запятую; пусто = все сквады панели
REMNAWAVE_SQUADS=

# Значения ниже (пробный период, курс звезды, рефералка) — начальные:
# их можно поменять в админке бота, тогда .env для них больше не используется.

# Пробный период
TRIAL_DAYS=3
# Канал для обязательной подписки перед триалом: @username или -100…; пусто = без проверки.
# Бота нужно добавить в канал администратором, иначе проверка не сработает.
TRIAL_CHANNEL=
# Ссылка на канал для кнопки (для @username не нужна, строится сама)
TRIAL_CHANNEL_URL=

# Оплата Telegram Stars: сколько рублей стоит одна звезда (цена в звёздах округляется вверх)
STARS_RUB_RATE=1.5
# Через сколько минут неоплаченный счёт отменяется, а зарезервированный баланс возвращается
PAYMENT_TTL_MINUTES=60

# Реферальная программа: % от оплаченной суммы первой и следующих покупок друга
REFERRAL_FIRST_PERCENT=20
REFERRAL_NEXT_PERCENT=10

# Часовой пояс для дат в сообщениях
DISPLAY_TIMEZONE=Europe/Moscow

# Язык по умолчанию, если пользователь ещё не выбрал: ru или en
DEFAULT_LANGUAGE=ru
LOG_LEVEL=INFO

# Резервные копии (deploy/backup.sh): Telegram ID, куда бот пришлёт архив. Пусто = не отправлять.
BACKUP_CHAT_ID=
