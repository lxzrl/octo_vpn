# Панель Remnawave и ссылки подписок (/api/sub/…) на одном домене.
# Сертификат Let's Encrypt Caddy получит сам: домен должен смотреть на этот сервер.
https://{$PANEL_DOMAIN} {
    encode
    reverse_proxy * http://remnawave:3000
}

# Запросы по IP или чужому домену: пустой ответ, панель не светится.
:443 {
    tls internal
    respond 204
}
